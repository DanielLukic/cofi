#!/usr/bin/env bash
set -euo pipefail

fail=0
repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_root"

if rg -n '#include "names/' src/matching; then
    echo "FAIL: src/matching must not include names/"
    fail=1
fi

if [[ "$fail" -eq 0 ]]; then
    echo "PASS: src/matching has no names/ includes"
fi

gc_callers="$(rg -l -g '*.c' -g '*.h' 'matching_run_gc\(' src | grep -v '^src/core/app/' || true)"
if [[ -n "$gc_callers" ]]; then
    echo "$gc_callers"
    echo "FAIL: per-action matching_run_gc callers must not remain outside core/app"
    fail=1
fi

if [[ "$fail" -eq 0 ]]; then
    echo "PASS: matching_run_gc is app-level startup-only"
fi

x11_forbidden_patterns=(
    'check_rule_match'
    'rule_breaker_'
)

for pattern in "${x11_forbidden_patterns[@]}"; do
    if rg -n "$pattern" src/x11/x11_events.c; then
        echo "FAIL: x11_events.c must delegate rule dispatch instead of using $pattern"
        fail=1
    fi
done

bad_trigger_refs="$(rg -n 'RULE_TRIGGER_' src/x11/x11_events.c | grep -v 'rules_apply(app, RULE_TRIGGER_' || true)"
if [[ -n "$bad_trigger_refs" ]]; then
    echo "$bad_trigger_refs"
    echo "FAIL: x11_events.c may only pass RuleTrigger values into rules_apply()"
    fail=1
fi

if [[ "$fail" -eq 0 ]]; then
    echo "PASS: x11_events.c delegates rule dispatch to rules/"
fi

exit "$fail"
