#!/usr/bin/env bash
# cofi pre-push hook: run the test suite before letting a push out.
# Install via: bash scripts/install-hooks.sh
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

zero_sha="0000000000000000000000000000000000000000"
ref_count=0
has_non_delete_ref=0

while read -r local_ref local_sha remote_ref remote_sha; do
    ref_count=$((ref_count + 1))
    if [[ "$local_sha" != "$zero_sha" ]]; then
        has_non_delete_ref=1
    fi
done

if [[ "$ref_count" -gt 0 && "$has_non_delete_ref" -eq 0 ]]; then
    echo "[pre-push] delete-only push; skipping make test"
    exit 0
fi

echo "[pre-push] make test"
if ! make test >/tmp/cofi-pre-push.log 2>&1; then
    echo "[pre-push] FAILED — see /tmp/cofi-pre-push.log" >&2
    tail -40 /tmp/cofi-pre-push.log >&2
    echo "[pre-push] push aborted. Fix tests, or bypass with --no-verify (discouraged)." >&2
    exit 1
fi
echo "[pre-push] tests passed"
