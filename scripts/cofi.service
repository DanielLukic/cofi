[Unit]
Description=cofi window switcher

[Service]
Type=simple
Environment=DISPLAY=:0
# SSH agent socket so remote-projects (TFD-772) can authenticate non-interactively.
# %t = XDG_RUNTIME_DIR; this path is the gnome-keyring ssh agent.
Environment=SSH_AUTH_SOCK=%t/keyring/ssh
ExecStart=@BINDIR@/cofi
Restart=always
RestartSec=3
StartLimitIntervalSec=60
StartLimitBurst=5

[Install]
WantedBy=default.target
